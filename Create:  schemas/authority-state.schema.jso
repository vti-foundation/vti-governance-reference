{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vtifoundation.org/schemas/authority-state.schema.json",
  "title": "Authority State Reference Schema",
  "description": "Non-normative public reference interface for representing authority-related state in the VTI Deterministic Governance Reference.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "authority_state_id",
    "subject_id",
    "scope",
    "status",
    "effective_at"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.1"
    },
    "authority_state_id": {
      "type": "string",
      "minLength": 1,
      "description": "Unique identifier for this authority-state representation."
    },
    "subject_id": {
      "type": "string",
      "minLength": 1,
      "description": "Identifier for the subject to which the authority state applies."
    },
    "scope": {
      "type": "string",
      "minLength": 1,
      "description": "Implementation-defined scope within which the authority state is relevant."
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive",
        "suspended",
        "expired",
        "unknown"
      ],
      "description": "Simplified public reference status. This vocabulary is non-normative."
    },
    "effective_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp at which this authority-state representation became effective."
    },
    "expires_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time",
      "description": "Optional expiration timestamp."
    },
    "source_reference": {
      "type": "string",
      "minLength": 1,
      "description": "Optional reference to the source or system from which this public authority-state representation was derived."
    },
    "metadata": {
      "type": "object",
      "description": "Optional implementation-specific metadata. Consumers should not treat metadata as normative authority-state semantics."
    }
  }
}
